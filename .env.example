# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here

# Admin User ID (for batch processing and admin commands)
ADMIN_ID=your_admin_user_id_here

# Telebirr Number (for payment instructions)
TELEBIRR_NUMBER=your_telebirr_number_here

# Example values:
# BOT_TOKEN: Get this from @BotFather on Telegram
# ADMIN_ID: Your Telegram user ID (get it from @userinfobot or similar)
# TELEBIRR_NUMBER: Your Telebirr payment number (format: +251xxxxx or similar)
